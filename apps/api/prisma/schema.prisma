// Milestone 2a — database foundation only.
// Domain catalog models arrive in Milestone 2b.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Lightweight metadata row used to prove migrations and connectivity.
/// Not part of the public product domain model.
model SchemaMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
