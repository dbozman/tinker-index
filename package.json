{
  "name": "tinker-index",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^24.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:web": "pnpm --filter @tinker-index/web start",
    "dev:api": "pnpm --filter @tinker-index/api start:dev",
    "dev:worker": "pnpm --filter @tinker-index/worker start:dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm --filter @tinker-index/contracts build && pnpm -r --if-present run typecheck",
    "test": "pnpm --filter @tinker-index/contracts build && pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @tinker-index/api test:e2e",
    "test:db": "pnpm --filter @tinker-index/api test:db",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @tinker-index/api prisma:generate",
    "db:migrate": "pnpm --filter @tinker-index/api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @tinker-index/api prisma:migrate:deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
