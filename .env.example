NODE_ENV=development

# API
API_PORT=3000
API_HOST=0.0.0.0

# Worker
WORKER_PORT=3001

# Web (Angular)
WEB_PORT=4200
API_BASE_URL=http://localhost:3000/api/v1

# PostgreSQL credentials (never commit real values)
POSTGRES_USER=tinker
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=tinker_index

# Preferred development path: Mac mini Postgres via SSH tunnel
#   pnpm db:up:remote
#   pnpm db:tunnel          # keep running in a separate terminal
# Then DATABASE_URL points at the tunneled local port:
DATABASE_URL=postgresql://tinker:replace-with-a-long-random-secret@localhost:5432/tinker_index

# Optional: override tunnel defaults
# TINKER_DB_SSH_HOST=danebozman@Danes-Mac-mini.local
# TINKER_DB_LOCAL_PORT=5432
# TINKER_DB_REMOTE_PORT=5436

# Agent / AI credentials (Milestone 5+)
# AGENT_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
